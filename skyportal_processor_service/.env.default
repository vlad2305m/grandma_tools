# SkyPortal Source Watcher Configuration
# Copy this file and customize the values for your environment

# ====== OWNCLOUD CONFIGURATION (REQUIRED) ======
OWNCLOUD_BASE_URL=https://grandma-owncloud.ijclab.in2p3.fr
OWNCLOUD_USERNAME=your_username_here
OWNCLOUD_TOKEN=your_owncloud_token_here
OWNCLOUD_USER_ID=your_user_id_here
# Path where folders of sources are located in ownCloud
SAVE_PATH=Candidates/Skyportal
# StdWeb DATA_PATH-relative path to the SAME tree, via a read-only davfs2 mount of
# OwnCloud under StdWeb's data/ dir (see stdweb_make_task's local_file docs in
# comment_watcher.py). When set, StdWeb copies files itself off the mount instead
# of this service downloading+re-uploading them. Leave unset until that mount
# exists -- do NOT enable prematurely, it will point StdWeb at a missing path.
STDWEB_SAVE_PATH=Candidates/Skyportal

# ====== SKYPORTAL CONFIGURATION (REQUIRED) ======
SKYPORTAL_URL=https://skyportal-icare.ijclab.in2p3.fr
SKYPORTAL_TOKEN=your_skyportal_token_here

# ======= STDWEB CONFIGURATION (REQUIRED) ======
STDWEB_URL=http://100.90.108.127:8000
STDWEB_TOKEN=your_stdweb_token_here
# OwnCloud telescope folder name -> SkyPortal instrument name (exact match).
# Required and exhaustive: a file under an unmapped telescope folder fails
# stage 7 (SkyPortal photometry upload) outright rather than silently using
# some default/generic instrument. List every telescope folder that appears
# under SAVE_PATH; check exact instrument names via GET /api/instrument on
# your SkyPortal instance. Example only -- these are placeholder names:
TELESCOPE_INSTRUMENT_MAP={"TAROT-TCA": "your_skyportal_instrument_name_here"}

# ====== APPLICATION SETTINGS (OPTIONAL) ======

# How often to check for new sources (seconds)
POLL_INTERVAL=60

# What to search for in comments to activate processing
SKYPORTAL_COMMAND=@rescan

# SkyPortal group IDs to monitor (comma-separated)
# Group 3 is GRANDNMA
GROUP_IDS=3

# Optional source tag filter (leave empty for no filter)
SOURCE_TAG=

# Optional start time (example: 2025-06-01T00:00:00Z). By default, the start date will be 1 day ago from the script launch
START_TIME= 

# ====== SLACK NOTIFICATIONS (OPTIONAL) ======
# Slack bot token for notifications (leave empty to disable)
SLACK_BOT_TOKEN=

# Service name (used as Slack channel name: #owncloud-folder-service)
SLACK_SERVICE_NAME=owncloud-folder-service

# ====== TESTING ONLY (tests/test_integration_comment_watcher.py) ======
# Host path of OwnCloud's on-disk data directory (its bind-mounted volume in
# docker-compose.yaml). The integration test writes fixture files here
# directly instead of through OwnCloud's write API -- see seed_owncloud_file
# in the test file. Not read by comment_watcher.py itself.
OWNCLOUD_DATA_PATH=../data/owncloud