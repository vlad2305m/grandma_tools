# SkyPortal Source Watcher Configuration
# Copy this file and customize the values for your environment

# ====== OWNCLOUD CONFIGURATION (REQUIRED) ======
OWNCLOUD_BASE_URL=https://grandma-owncloud.ijclab.in2p3.fr
OWNCLOUD_USERNAME=your_username_here
OWNCLOUD_TOKEN=your_owncloud_token_here
OWNCLOUD_USER_ID=your_user_id_here
# Path where folders of sources are located in ownCloud
SAVE_PATH=Candidates/Skyportal
# Path where folders of sources are located in StdWeb relative to data/.
# Optional: if unset, files will be downloaded from owncloud and uploaded to StdWeb.
STDWEB_SAVE_PATH=Candidates/Skyportal

# ====== SKYPORTAL CONFIGURATION (REQUIRED) ======
SKYPORTAL_URL=https://skyportal-icare.ijclab.in2p3.fr
SKYPORTAL_TOKEN=your_skyportal_token_here

# ======= STDWEB CONFIGURATION (REQUIRED) ======
STDWEB_URL=https://grandma-stdpipe.ijclab.in2p3.fr
STDWEB_TOKEN=your_stdweb_token_here
# StdWeb Group *name* every created task is shared with.
STDWEB_GROUP_ID=skyportal
# OwnCloud telescope folder name -> SkyPortal instrument name. Only needed
# for folders whose names don't match.
TELESCOPE_INSTRUMENT_MAP={"Les-Makes-T60": "Les-Makes/T60", "OHP-IRIS": "OHP/IRIS", "OPD-60cm": "OPD/60cm", "TAROT-TCA": "TAROT/TCA", "TAROT-TCH": "TAROT/TCH", "TAROT-TRE": "TAROT/TRE", "TNT": "Xinglong-TNT", "UBAI-AZT-22": "UBAI/AZT-22", "UBAI-NT-60": "UBAI/NT-60", "UBAI-ST-60": "UBAI/ST-60"}

# ====== APPLICATION SETTINGS (OPTIONAL) ======

# How often to check for new comments (seconds)
POLL_INTERVAL=60

# Logging verbosity for this service's messages: DEBUG, INFO (default),
# WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# What to search for in comments to activate processing
SKYPORTAL_COMMAND=@rescan

# If false, any comment triggers a check for new files
REQUIRE_COMMAND=true

# Externally-reachable base URL for this process's HTTP listener (e.g.
# http://100.90.108.127:8765, reachable from wherever SkyPortal itself runs),
# so SkyPortal's "Run Analysis" button/API can trigger a rescan.
# Leave unset (default) to keep this service comment-triggered only.
WEBHOOK_URL=
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8765

# SkyPortal group IDs to share analysis logs with. Group 3 is GRANDMA.
GROUP_IDS=3

# Optional start time (example: 2025-06-01T00:00:00Z). By default, the start date will be 1 day ago from the script launch
START_TIME= 